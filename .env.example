# DeepSeek API 配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 本地模型接口配置（预留）
LOCAL_MODEL_BASE=http://localhost:8000/v1
LOCAL_MODEL_NAME=local-model

# Embeddings 模型首次启动时下载到该目录，之后只从本地加载
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_MODEL_PATH=./data/embeddings/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_AUTO_DOWNLOAD=true

# 对话配置
MODEL_NAME=deepseek-chat
MAX_TOKENS=4000
TEMPERATURE=0.7

# 自定义 OpenAI-compatible Base URL 的允许域名，逗号分隔
LLM_CONFIG_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,dashscope.aliyuncs.com,open.bigmodel.cn

# 实验性上下文路由（默认关闭；小程序可按请求开启）
CONTEXT_ROUTER_ENABLED=false
CONTEXT_ROUTER_PROVIDER=deepseek
CONTEXT_ROUTER_HISTORY_EXCHANGES=2
# CrossEncoder 智能搜索（请求级开关，首次使用时懒加载模型）
RERANKER_AVAILABLE=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_MODEL_PATH=./data/reranker/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_AUTO_DOWNLOAD=true
RERANKER_CANDIDATE_K=30
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512

# 管理控制台（首次启动时从环境变量生成哈希并写入 data/admin_control.db）
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-local-secret
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=false
ADMIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
