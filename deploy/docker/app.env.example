# Configure these before first start; never include the completed file in a release.
DEEPSEEK_API_KEY=
ADMIN_INITIAL_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_COOKIE_SECURE=true
ADMIN_CORS_ORIGINS=https://your-campusqa-host.example
FILE_PROCESSING_WORKERS=2
OMP_NUM_THREADS=2
MAX_TOKENS=4000
# User authentication and personal-model encryption are required by this release.
# Keep the original encryption key when moving existing encrypted personal settings.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
USER_LLM_ENCRYPTION_KEY=
