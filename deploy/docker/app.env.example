# Configure these before first start; never include the completed file in a release.
DEEPSEEK_API_KEY=
ADMIN_INITIAL_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_COOKIE_SECURE=true
ADMIN_CORS_ORIGINS=https://your-campusqa-host.example
FILE_PROCESSING_WORKERS=2
OMP_NUM_THREADS=2
MAX_TOKENS=4000
# User authentication and personal-model encryption are required by this release.
# Keep the original encryption key when moving existing encrypted personal settings.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
USER_LLM_ENCRYPTION_KEY=

# Shared CPU process: keep one uvicorn worker (already enforced by offline.py).
INFERENCE_CPU_THREADS=2
INFERENCE_INTEROP_THREADS=1
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
RERANKER_BACKEND=torch
RERANKER_DEVICE=cpu
# After exporting/repackaging the selected model: RERANKER_BACKEND=onnx
RERANKER_ONNX_FILE=onnx/model_qint8_avx2.onnx
RERANKER_MAX_CONCURRENT=1
RERANKER_MAX_QUEUE=8
RERANKER_QUEUE_TIMEOUT_SECONDS=30
RERANKER_SCORE_CACHE_SIZE=4096
